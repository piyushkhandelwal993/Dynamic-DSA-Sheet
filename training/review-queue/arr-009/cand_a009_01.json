    "code": "import java.util.*;\n\nclass Solution {\n    public int removeDuplicates(int[] nums) {\n        if (nums.length == 0) return 0;\n        int write = 1;\n        for (int read = 1; read < nums.length; read++) {\n            if (nums[read] != nums[write - 1]) nums[write++] = nums[read];\n        }\n        return write;\n    }\n}\n",
