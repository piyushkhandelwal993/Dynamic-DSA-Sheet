    "code": "import java.util.*;\nclass Solution {\n    public int secondLargest(int[] nums) {\n        Arrays.sort(nums);\n        int largest = nums[nums.length - 1];\n        for (int i = nums.length - 2; i >= 0; i--) {\n            if (nums[i] != largest) {\n                return nums[i];\n            }\n        }\n        return Integer.MIN_VALUE;\n    }\n}",
