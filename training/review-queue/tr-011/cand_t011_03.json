    "label": "collect-sort-rebuild-with-skip",
    "code": "import java.util.*;\n\nclass Solution {\n    public TreeNode deleteBST(TreeNode root, int key) {\n        List<Integer> values = new ArrayList<>();\n        inorder(root, values);\n        boolean removed = false;\n        List<Integer> kept = new ArrayList<>();\n        for (int value : values) {\n            if (!removed && value == key) {\n                removed = true;\n                continue;\n            }\n            kept.add(value);\n        }\n        return build(kept, 0, kept.size() - 1);\n    }\n\n    private void inorder(TreeNode node, List<Integer> values) {\n        if (node == null) {\n            return;\n        }\n        inorder(node.left, values);\n        values.add(node.val);\n        inorder(node.right, values);\n    }\n\n    private TreeNode build(List<Integer> values, int left, int right) {\n        if (left > right) {\n            return null;\n        }\n        int mid = (left + right) / 2;\n        TreeNode node = new TreeNode(values.get(mid));\n        node.left = build(values, left, mid - 1);\n        node.right = build(values, mid + 1, right);\n        return node;\n    }\n}",
    "notes": "Functionally works but rebuilds the whole BST rather than deleting in O(h).",
