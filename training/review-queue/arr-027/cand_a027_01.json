    "code": "import java.util.*;\n\nclass Solution {\n    public long countSubarraysWithSumK(int[] nums, int k) {\n        Map<Integer, Integer> count = new HashMap<>();\n        count.put(0, 1);\n        int sum = 0, answer = 0;\n        for (int value : nums) {\n            sum += value;\n            answer += count.getOrDefault(sum - k, 0);\n            count.put(sum, count.getOrDefault(sum, 0) + 1);\n        }\n        return answer;\n    }\n}\n",
