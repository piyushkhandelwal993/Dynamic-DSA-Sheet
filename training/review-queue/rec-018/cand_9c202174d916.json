    "code": "import java.util.*;\n\nclass Solution {\n    public int josephus(int n, int k) {\n        return solveZeroBased(n, k) + 1;\n    }\n\n    private int solveZeroBased(int peopleCount, int stepSize) {\n        if (peopleCount == 1) {\n            return 0;\n        }\n\n        return (solveZeroBased(peopleCount - 1, stepSize) + stepSize) % peopleCount;\n    }\n}",
