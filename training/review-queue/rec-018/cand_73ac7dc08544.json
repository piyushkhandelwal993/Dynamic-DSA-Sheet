    "code": "import java.util.*;\n\nclass Solution {\n    public int josephus(int n, int k) {\n        ArrayList<Integer> people = new ArrayList<>();\n\n        for (int person = 1; person <= n; person++) {\n            people.add(person);\n        }\n\n        int removeIndex = 0;\n\n        while (people.size() > 1) {\n            removeIndex = (removeIndex + k - 1) % people.size();\n            people.remove(removeIndex);\n        }\n\n        return people.get(0);\n    }\n}",
