    "label": "list-frontier-bfs",
    "code": "import java.util.*;\n\nclass Solution {\n    public List<Integer> levelOrder(TreeNode root) {\n        List<Integer> answer = new ArrayList<>();\n        if (root == null) {\n            return answer;\n        }\n        List<TreeNode> frontier = new ArrayList<>();\n        frontier.add(root);\n        int index = 0;\n        while (index < frontier.size()) {\n            TreeNode node = frontier.get(index++);\n            answer.add(node.val);\n            if (node.left != null) {\n                frontier.add(node.left);\n            }\n            if (node.right != null) {\n                frontier.add(node.right);\n            }\n        }\n        return answer;\n    }\n}",
    "notes": "Breadth-first traversal using a growing list and index instead of Queue API.",
