    "code": "import java.util.*;\n\nclass Solution {\n    public Node reverse(Node head) {\n        Node dummy = new Node(0);\n        Node curr = head;\n        while (curr != null) {\n            Node next = curr.next;\n            curr.next = dummy.next;\n            dummy.next = curr;\n            curr = next;\n        }\n        return dummy.next;\n    }\n}",
