    "label": "include-exclude-sum",
    "code": "import java.util.*;\n\nclass Solution {\n    public boolean subsetSumExists(int[] nums, int target) {\n        return search(nums, 0, 0, target);\n    }\n\n    private boolean search(int[] nums, int index, int currentSum, int target) {\n        if (currentSum == target) {\n            return true;\n        }\n        if (index == nums.length || currentSum > target) {\n            return false;\n        }\n        if (search(nums, index + 1, currentSum + nums[index], target)) {\n            return true;\n        }\n        return search(nums, index + 1, currentSum, target);\n    }\n}\n",
