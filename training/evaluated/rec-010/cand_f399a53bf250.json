    "code": "import java.util.*;\n\nclass Solution {\n    public int countDigits(int n) {\n        return countDigits(n, 0);\n    }\n\n    private int countDigits(int n, int count) {\n        if (n == 0) {\n            return Math.max(1, count);\n        }\n        return countDigits(n / 10, count + 1);\n    }\n}\n",
