    "code": "import java.util.*;\n\nclass Solution {\n    public Node reverse(Node head) {\n        Node prev = null;\n        Node curr = head;\n        while (curr != null) {\n            Node next = curr.next;\n            curr.next = prev;\n            prev = curr;\n            curr = next;\n        }\n        return prev;\n    }\n}",
