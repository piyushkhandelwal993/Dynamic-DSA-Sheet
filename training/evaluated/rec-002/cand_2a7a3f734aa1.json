    "code": "import java.util.*;\n\nclass Solution {\n    public void printOneToN(int n) {\n        printFrom(1, n);\n    }\n\n    private void printFrom(int current, int n) {\n        if (current > n) {\n            return;\n        }\n        if (current > 1) {\n            System.out.print(\" \");\n        }\n        System.out.print(current);\n        printFrom(current + 1, n);\n    }\n}\n",
