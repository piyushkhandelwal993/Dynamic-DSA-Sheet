    "code": "import java.util.*;\n\nclass Solution {\n    public int sumFirstN(int n) {\n        return sumUntil(n, 0);\n    }\n\n    private int sumUntil(int n, int currentSum) {\n        if (n <= 0) {\n            return currentSum;\n        }\n        return sumUntil(n - 1, currentSum + n);\n    }\n}\n",
